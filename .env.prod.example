# ---- Domain / TLS ----
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ---- Django ----
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,web,localhost

# Optional hardening: Caddy already terminates TLS and only forwards to the
# frontend, which proxies to Django over the internal Docker network, so these
# are off by default. Only enable if you've confirmed X-Forwarded-Proto is
# reliably forwarded end-to-end, otherwise SECURE_SSL_REDIRECT can cause
# redirect loops on internal requests.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# ---- Database ----
POSTGRES_DB=magic_trade
POSTGRES_USER=magic_trade
POSTGRES_PASSWORD=changeme-strong-password
DATABASE_URL=postgres://magic_trade:changeme-strong-password@db:5432/magic_trade

# ---- CORS (leave empty unless the browser needs to call Django directly, which it shouldn't with this architecture) ----
CORS_ALLOWED_ORIGINS=

# ---- OAuth ----
FACEBOOK_CLIENT_ID=
FACEBOOK_SECRET=
FACEBOOK_REDIRECT_URI=https://example.com/auth/callback/facebook
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=https://example.com/auth/callback/google

# ---- Frontend -> Backend internal routing ----
BACKEND_INTERNAL_URL=http://web:8000
